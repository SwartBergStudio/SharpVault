@page "/not-found"
@attribute [AllowAnonymous]

<PageTitle>Not found</PageTitle>

<section class="sv-state">
    <div class="sv-state__visual">
        <Icon Name="IconName.Vault" CssClass="sv-icon--xl" />
    </div>
    <p class="sv-plate">404</p>
    <h1 id="not-found-heading">Not found</h1>
    <p id="not-found-message" class="sv-state__body">The page you are looking for does not exist.</p>
    <div class="sv-state__actions">
        <a id="not-found-home-link" href="" class="sv-btn">Home</a>
    </div>
</section>
