@page "/not-found"
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]

<PageTitle>Not found</PageTitle>

<StatePanel Id="not-found" TitleId="not-found-heading" Icon="@SvIcons.Vault" HeadingLevel="1" Title="Not found">
    <ChildContent>
        <p class="sv-plate">404</p>
        <p id="not-found-message">The page you are looking for does not exist.</p>
    </ChildContent>
    <Actions>
        <SvButton Id="not-found-home-link" Variant="SvButtonVariant.Secondary" Icon="@SvIcons.Home" Href="@AccountRoutes.Home">Start page</SvButton>
    </Actions>
</StatePanel>
