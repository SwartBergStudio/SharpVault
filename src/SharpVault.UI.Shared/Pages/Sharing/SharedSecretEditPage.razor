@page "/shared/{OwnerId:guid}/secrets/{SecretId:guid}/edit"
@attribute [Authorize]

<PageTitle>Edit shared item</PageTitle>

<SharedSecretEditor @key="@($"{OwnerId}/{SecretId}")" OwnerId="OwnerId" SecretId="SecretId" />

@code {
    [Parameter]
    public Guid OwnerId { get; set; }

    [Parameter]
    public Guid SecretId { get; set; }
}
