@page "/account/signed-out"
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]

<PageTitle>Signed out</PageTitle>

<StatePanel Id="signed-out" TitleId="signed-out-heading" HeadingLevel="1" Title="You have been signed out">
    <Visual>
        <VaultDoor Sealing="true" />
    </Visual>
    <Actions>
        <SignInLink Id="signed-out-sign-in-link" Text="Sign in again" />
    </Actions>
</StatePanel>
