@page "/account/sign-in-error"
@attribute [AllowAnonymous]

<PageTitle>Sign-in failed</PageTitle>

<h1 id="sign-in-error-heading">Sign-in failed</h1>
<p id="sign-in-error-message">We could not sign you in. Try again, and contact your administrator if the problem continues.</p>
<a id="sign-in-error-retry-link" href="@AccountRoutes.SignIn">Try again</a>
