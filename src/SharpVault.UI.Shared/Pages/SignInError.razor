@page "/account/sign-in-error"
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]

<PageTitle>Sign-in failed</PageTitle>

<StatePanel Id="sign-in-error" TitleId="sign-in-error-heading" Kind="StatePanelKind.Danger" Icon="@SvIcons.Danger" HeadingLevel="1" Title="Sign-in failed">
    <ChildContent>
        <p id="sign-in-error-message">We could not sign you in. Try again, and contact your administrator if the problem continues.</p>
    </ChildContent>
    <Actions>
        <SignInLink Id="sign-in-error-retry-link" Text="Try again" />
    </Actions>
</StatePanel>
