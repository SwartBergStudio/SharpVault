@page "/account/access-denied"
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]

<PageTitle>Access denied</PageTitle>

<StatePanel Id="access-denied" TitleId="access-denied-heading" Kind="StatePanelKind.Danger" Icon="@SvIcons.Lock" HeadingLevel="1" Title="You do not have access to SharpVault">
    <ChildContent>
        <p id="access-denied-message">Ask your administrator to give you access.</p>
    </ChildContent>
    <Actions>
        <AuthorizeView>
            <NotAuthorized>
                <SvButton Id="access-denied-home-link" Variant="SvButtonVariant.Secondary" Icon="@SvIcons.Home" Href="@AccountRoutes.Home">Start page</SvButton>
            </NotAuthorized>
        </AuthorizeView>
    </Actions>
</StatePanel>
