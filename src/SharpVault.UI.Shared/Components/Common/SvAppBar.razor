<MudAppBar id="@Id" Elevation="0" Class="sv-appbar">@ChildContent</MudAppBar>

@code {
    [Parameter, EditorRequired]
    public string Id { get; set; } = string.Empty;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    protected override void OnParametersSet() => ComponentIds.EnsureValid(Id, nameof(Id));
}
