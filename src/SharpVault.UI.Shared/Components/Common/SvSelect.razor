<div class="field-select">
    <label for="@Id">@Label</label>
    <select id="@Id" value="@Value" disabled="@Disabled" @onchange="HandleChangeAsync">
        @foreach (var option in Options)
        {
            <option @key="option.Value" value="@option.Value">@option.Text</option>
        }
    </select>
</div>

@code {
    [Parameter, EditorRequired]
    public string Id { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string Label { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public IReadOnlyList<SvSelectOption> Options { get; set; } = [];

    [Parameter]
    public string? Value { get; set; }

    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    protected override void OnParametersSet()
    {
        ComponentIds.EnsureValid(Id, nameof(Id));
        ArgumentException.ThrowIfNullOrWhiteSpace(Label);
    }

    private Task HandleChangeAsync(ChangeEventArgs args) => ValueChanged.InvokeAsync(args.Value?.ToString() ?? string.Empty);
}
