<MudGrid id="@Id" Spacing="@Spacing">@ChildContent</MudGrid>

@code {
    [Parameter]
    public string? Id { get; set; }

    [Parameter]
    public int Spacing { get; set; } = 6;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    protected override void OnParametersSet()
    {
        if (Id is not null)
        {
            ComponentIds.EnsureValid(Id, nameof(Id));
        }
    }
}
