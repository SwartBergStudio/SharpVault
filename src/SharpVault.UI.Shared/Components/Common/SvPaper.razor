<MudPaper id="@Id" Class="@Class" Outlined="true" Elevation="0">@ChildContent</MudPaper>

@code {
    [Parameter]
    public string? Id { get; set; }

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    protected override void OnParametersSet()
    {
        if (Id is not null)
        {
            ComponentIds.EnsureValid(Id, nameof(Id));
        }
    }
}
