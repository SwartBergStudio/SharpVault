<div id="@($"{IdPrefix}-frame")" class="sv-secret" data-state="@(Revealed ? "revealed" : "hidden")">
    <span id="@($"{IdPrefix}-state")" class="sv-secret__state">
        <Icon Name="@(Revealed ? IconName.Eye : IconName.Lock)" />
        <span>@(Revealed ? "Visible" : "Hidden")</span>
    </span>
    <span id="@IdPrefix" class="sv-secret__value notranslate" translate="no">@if (Revealed)
        {
            @ChildContent
        }
        else
        {
            <span class="sv-secret__mask" aria-hidden="true">@MaskText</span><span class="sv-visually-hidden">Hidden value</span>
        }</span>
    @if (Actions is not null)
    {
        <span class="sv-secret__actions">@Actions</span>
    }
</div>

@code {
    public const string MaskText = "••••••••";

    [Parameter, EditorRequired]
    public string IdPrefix { get; set; } = string.Empty;

    [Parameter]
    public bool Revealed { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public RenderFragment? Actions { get; set; }

    protected override void OnParametersSet() => ComponentIds.EnsureValid(IdPrefix, nameof(IdPrefix));
}
