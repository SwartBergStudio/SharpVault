<MudPaper id="@Id" Class="@PanelClass" Outlined="true" Elevation="0" role="@Role" aria-labelledby="@ResolvedTitleId">
    @if (Visual is not null)
    {
        <div class="sv-state-panel__visual">@Visual</div>
    }
    else
    {
        <MudIcon Icon="@Icon" Color="@IconColor" Size="Size.Large" aria-hidden="true" />
    }
    <MudText id="@ResolvedTitleId" Typo="Typo.h5" HtmlTag="@HeadingTag">@Title</MudText>
    @if (ChildContent is not null)
    {
        <div class="sv-state-panel__body">@ChildContent</div>
    }
    @if (Actions is not null)
    {
        <div class="sv-state-panel__actions">@Actions</div>
    }
</MudPaper>

@code {
    [Parameter, EditorRequired]
    public string Id { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string? TitleId { get; set; }

    [Parameter]
    public StatePanelKind Kind { get; set; }

    [Parameter]
    public string Icon { get; set; } = SvIcons.Info;

    [Parameter]
    public int HeadingLevel { get; set; } = 2;

    [Parameter]
    public RenderFragment? Visual { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public RenderFragment? Actions { get; set; }

    private string ResolvedTitleId => TitleId ?? $"{Id}-title";

    private string HeadingTag => HeadingLevel == 1 ? "h1" : "h2";

    private string Role => Kind == StatePanelKind.Neutral ? "status" : "alert";

    private string PanelClass => $"sv-state-panel sv-state-panel--{Kind.ToString().ToLowerInvariant()}";

    private Color IconColor => Kind switch
    {
        StatePanelKind.Warning => Color.Warning,
        StatePanelKind.Danger => Color.Error,
        _ => Color.Primary,
    };

    protected override void OnParametersSet()
    {
        ComponentIds.EnsureValid(Id, nameof(Id));
        if (TitleId is not null)
        {
            ComponentIds.EnsureValid(TitleId, nameof(TitleId));
        }
    }
}
