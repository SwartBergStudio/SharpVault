<span id="@Id" class="sv-busy" role="status">
    <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Primary" aria-hidden="true" />
    <span class="sv-visually-hidden">@Label</span>
</span>

@code {
    [Parameter, EditorRequired]
    public string Id { get; set; } = string.Empty;

    [Parameter]
    public string Label { get; set; } = "Working";

    protected override void OnParametersSet() => ComponentIds.EnsureValid(Id, nameof(Id));
}
