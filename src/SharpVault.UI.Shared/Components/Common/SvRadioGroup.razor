@typeparam TValue

<MudRadioGroup T="TValue" Value="@Value" ValueChanged="@ValueChanged">@ChildContent</MudRadioGroup>

@code {
    [Parameter]
    public TValue? Value { get; set; }

    [Parameter]
    public EventCallback<TValue?> ValueChanged { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
