<SvDialog IdPrefix="@IdPrefix" Title="@Title" Open="@Open" Danger="@Danger" Busy="@Busy" OnCancel="@OnCancel">
    <ChildContent>
        <SvTextField Id="@($"{IdPrefix}-reason")" Label="Reason" Value="@_reason" ValueChanged="@SetReason" Lines="3" MaxLength="@AdminReasonRules.MaxLength" Required="true" Disabled="@Busy" HelperText="@ReasonHelp" />
    </ChildContent>
    <Footer>
        <SvButton Id="@($"{IdPrefix}-cancel")" Variant="SvButtonVariant.Secondary" Disabled="@Busy" OnClick="@HandleCancelAsync">Cancel</SvButton>
        <SvButton Id="@($"{IdPrefix}-confirm")" Variant="@(Danger ? SvButtonVariant.Danger : SvButtonVariant.Primary)" Busy="@Busy" Disabled="@(!CanSubmit)" OnClick="@HandleConfirmAsync">@ConfirmText</SvButton>
    </Footer>
</SvDialog>

@code {
    private const string ReasonHelp = "Say why in at least 20 characters. The reason stays in the audit log.";

    private string _reason = string.Empty;
    private bool _wasOpen;

    [Parameter, EditorRequired]
    public string IdPrefix { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string ConfirmText { get; set; } = string.Empty;

    [Parameter]
    public bool Open { get; set; }

    [Parameter]
    public bool Danger { get; set; }

    [Parameter]
    public bool Busy { get; set; }

    [Parameter]
    public EventCallback<string> OnConfirm { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    private bool CanSubmit => !Busy && AdminReasonRules.IsValid(_reason);

    protected override void OnParametersSet()
    {
        if (Open && !_wasOpen)
        {
            _reason = string.Empty;
        }

        _wasOpen = Open;
    }

    private void SetReason(string value) => _reason = value;

    private Task HandleConfirmAsync() => CanSubmit ? OnConfirm.InvokeAsync(_reason.Trim()) : Task.CompletedTask;

    private Task HandleCancelAsync() => OnCancel.InvokeAsync();
}
