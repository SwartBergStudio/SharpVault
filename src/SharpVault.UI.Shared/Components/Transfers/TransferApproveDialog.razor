<ConfirmDialog IdPrefix="transfer-approve-dialog" Title="Approve this transfer?" Open="@Open" ConfirmText="Approve" Busy="@Busy" OnConfirm="@OnConfirm" OnCancel="@OnCancel">
    <ChildContent>
        <p id="transfer-approve-dialog-summary">@Summary</p>
    </ChildContent>
</ConfirmDialog>

@code {
    [Parameter]
    public bool Open { get; set; }

    [Parameter]
    public bool Busy { get; set; }

    [Parameter]
    public string Summary { get; set; } = string.Empty;

    [Parameter]
    public EventCallback OnConfirm { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }
}
