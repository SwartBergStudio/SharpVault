@inherits LoadableComponentBase<OneTimeLinkNoticeListDto>
@inject IOneTimeLinksApiClient Links

<DataStateView TValue="OneTimeLinkNoticeListDto" IdPrefix="one-time-link-notice-list" State="State" Value="Value" ErrorText="@ErrorText" OnRetry="ReloadAsync">
    <Loading></Loading>
    <Empty></Empty>
    <Error></Error>
    <ChildContent>
        <SvStack Spacing="2">
            <StatusBanner Id="one-time-link-notice-status" Message="@_status" />
            @foreach (var notice in _rows)
            {
                <SvAlert Id="@($"one-time-link-notice-{notice.LinkId:D}")" Kind="AlertKind.Info">
                    <SvStack Spacing="2">
                        <span>@NoticeText(notice)</span>
                        <div class="d-flex flex-wrap gap-2">
                            <SvButton Id="@($"one-time-link-notice-dismiss-{notice.LinkId:D}")" Variant="SvButtonVariant.Secondary" Icon="@SvIcons.Close" Disabled="IsCommandRunning" OnClick="@(_ => DismissAsync(notice))">Dismiss</SvButton>
                        </div>
                    </SvStack>
                </SvAlert>
            }
        </SvStack>
    </ChildContent>
</DataStateView>
