<div class="d-flex align-center flex-wrap gap-2">
    <SvLink Id="@($"vault-secret-link-{Secret.Id:D}")" Href="@VaultRoutes.Secret(Secret.Id)">@SecretDisplayName.For(Secret)</SvLink>
    @if (Secret.IsDamaged)
    {
        <StatusChip Id="@($"vault-secret-damaged-{Secret.Id:D}")" Status="SecurityStatus.Warning" Label="Damaged" />
    }
</div>

@code {
    [Parameter, EditorRequired]
    public SecretDto Secret { get; set; } = default!;
}
