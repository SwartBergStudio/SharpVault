@inherits LoadableComponentBase<SecretVersionListDto>

<SvPageTitle Id="history-heading">@HeadingText</SvPageTitle>
<div class="mb-3">
    <SvButton Id="history-back" Variant="SvButtonVariant.Ghost" Icon="@SvIcons.Vault" Href="@VaultRoutes.Secret(SecretId)">Back to secret</SvButton>
</div>

@if (_conflict)
{
    <SvAlert Id="history-conflict" Kind="AlertKind.Warning">@VaultStatusText.ConflictText</SvAlert>
    <SvButton Id="history-conflict-reload" Variant="SvButtonVariant.Secondary" Icon="@SvIcons.Refresh" OnClick="@HandleConflictReload">Reload</SvButton>
}

<StatusBanner Id="history-status" Message="@_status" ExpireAfter="@Settings.ClipboardClearDelay" />

<DataStateView TValue="SecretVersionListDto" IdPrefix="history" EmptyTitle="No earlier versions" EmptyDescription="Earlier values appear here each time you replace an item's value." State="State" Value="Value" ErrorText="@ErrorText" OnRetry="ReloadAsync">
    <ChildContent>
        <SvTable Id="history-list" TItem="SecretVersionDto" Items="context.Items">
            <Columns>
                <SvColumn TItem="SecretVersionDto" Header="Replaced" Context="version">
                    <span id="@($"history-replaced-{version.VersionId:D}")">@ReplacedText(version)</span>
                </SvColumn>
                <SvColumn TItem="SecretVersionDto" Header="Value" Context="version">
                    <RevealableField IdPrefix="@($"history-value-{version.VersionId:D}")" Label="Previous value" Reveal="@RevealerFor(version)" OnFailure="HandleRevealFailureAsync" OnCopied="@ReportCopied" OnSucceeded="@ClearFailure" />
                </SvColumn>
                <SvColumn TItem="SecretVersionDto" Header="Actions" Context="version">
                    <SvButton Id="@($"history-restore-{version.VersionId:D}")" Variant="SvButtonVariant.Secondary" Icon="@SvIcons.Restore" Disabled="IsCommandRunning" OnClick="@(() => AskRestore(version))">Restore</SvButton>
                </SvColumn>
            </Columns>
        </SvTable>
    </ChildContent>
</DataStateView>

<ConfirmDialog IdPrefix="history-restore-prompt" Title="Restore this version?" Open="@(_restoreTarget is not null)" ConfirmText="Restore" Busy="IsCommandRunning" OnConfirm="ConfirmRestoreAsync" OnCancel="CancelRestore">
    <p>The current value is kept as a new version, and this earlier value becomes the current value.</p>
</ConfirmDialog>
