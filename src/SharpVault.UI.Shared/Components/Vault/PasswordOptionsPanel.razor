<SvStack Spacing="1">
    <SvSlider Id="generator-length" Label="Length" Min="@GeneratorLimits.MinLength" Max="@GeneratorLimits.MaxLength" Value="@Options.Length" ValueChanged="@(length => Change(Options with { Length = length }))" />
    <SvCheckbox Id="generator-lowercase" Label="Lowercase letters" Value="@Has(CharacterSets.Lowercase)" ValueChanged="@(on => Toggle(CharacterSets.Lowercase, on))" />
    <SvCheckbox Id="generator-uppercase" Label="Uppercase letters" Value="@Has(CharacterSets.Uppercase)" ValueChanged="@(on => Toggle(CharacterSets.Uppercase, on))" />
    <SvCheckbox Id="generator-digits" Label="Digits" Value="@Has(CharacterSets.Digits)" ValueChanged="@(on => Toggle(CharacterSets.Digits, on))" />
    <SvCheckbox Id="generator-symbols" Label="Symbols" Value="@Has(CharacterSets.Symbols)" ValueChanged="@(on => Toggle(CharacterSets.Symbols, on))" />
    <SvCheckbox Id="generator-exclude-ambiguous" Label="Leave out look-alike characters" Value="@Options.ExcludeAmbiguous" ValueChanged="@(on => Change(Options with { ExcludeAmbiguous = on }))" />
    <SvCheckbox Id="generator-require-every-set" Label="Use every chosen set at least once" Value="@Options.RequireEverySet" ValueChanged="@(on => Change(Options with { RequireEverySet = on }))" />
</SvStack>

@code {
    [Parameter, EditorRequired]
    public PasswordOptions Options { get; set; } = PasswordOptions.Default;

    [Parameter]
    public EventCallback<PasswordOptions> OptionsChanged { get; set; }

    private bool Has(CharacterSets set) => Options.Sets.HasFlag(set);

    private Task Toggle(CharacterSets set, bool on) =>
        Change(Options with { Sets = on ? Options.Sets | set : Options.Sets & ~set });

    private Task Change(PasswordOptions options) => OptionsChanged.InvokeAsync(options);
}
