<SvDialog IdPrefix="move-secret" Title="Move item" Open="@Open" Busy="@Busy" OnCancel="@OnCancel">
    <ChildContent>
        <SvStack Spacing="3">
            <FolderPicker Id="move-secret-folder-select" Label="Folder" Folders="@Folders" Value="@_selected" ValueChanged="@SelectFolder" />
            @if (ErrorText is not null)
            {
                <SvAlert Id="move-secret-error" Kind="AlertKind.Danger">@ErrorText</SvAlert>
            }
        </SvStack>
    </ChildContent>
    <Footer>
        <SvButton Id="move-secret-cancel" Variant="SvButtonVariant.Secondary" Disabled="@Busy" OnClick="@HandleCancelAsync">Cancel</SvButton>
        <SvButton Id="move-secret-confirm" Variant="SvButtonVariant.Primary" Busy="@Busy" OnClick="@HandleConfirmAsync">Move</SvButton>
    </Footer>
</SvDialog>

@code {
    private Guid? _selected;
    private bool _wasOpen;

    [Parameter]
    public bool Open { get; set; }

    [Parameter]
    public Guid? CurrentFolderId { get; set; }

    [Parameter]
    public IReadOnlyList<FolderDto> Folders { get; set; } = [];

    [Parameter]
    public bool Busy { get; set; }

    [Parameter]
    public string? ErrorText { get; set; }

    [Parameter]
    public EventCallback<Guid?> OnConfirm { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    protected override void OnParametersSet()
    {
        if (Open && !_wasOpen)
        {
            _selected = CurrentFolderId;
        }

        _wasOpen = Open;
    }

    private void SelectFolder(Guid? folderId) => _selected = folderId;

    private Task HandleConfirmAsync() => OnConfirm.InvokeAsync(_selected);

    private Task HandleCancelAsync() => OnCancel.InvokeAsync();
}
