@inherits LoadableComponentBase<SecretPageDto>

<StatusBanner Id="vault-status" Message="@_status" />
<DataStateView TValue="SecretPageDto" IdPrefix="vault-secrets" EmptyTitle="@EmptyTitle" EmptyDescription="@EmptyDescription" State="State" Value="Value" ErrorText="@ErrorText" OnRetry="ReloadAsync">
    <ChildContent>
        <SvTable Id="vault-secret-list" TItem="SecretDto" Items="_rows">
            <Columns>
                <SvColumn TItem="SecretDto" Header="Name" Context="secret">
                    <SecretNameCell Secret="@secret" />
                </SvColumn>
                <SvColumn TItem="SecretDto" Header="Type" Value="@(secret => SecretTypeLabels.Label(secret.Type))" />
                <SvColumn TItem="SecretDto" Header="Username" Value="@(secret => secret.Username)" />
                <SvColumn TItem="SecretDto" Header="Copy" Context="secret">
                    @if (secret.HasValue)
                    {
                        <SvIconButton Id="@($"vault-secret-copy-{secret.Id:D}")" Icon="@SvIcons.Copy" Label="@($"Copy value of {SecretDisplayName.For(secret)}")" Disabled="@IsCommandRunning" OnClick="@(() => CopyAsync(secret))" />
                    }
                </SvColumn>
            </Columns>
        </SvTable>
        @if (LoadMoreFailed)
        {
            <SvAlert Id="vault-load-more-error" Kind="AlertKind.Danger">@LoadMoreText</SvAlert>
        }
        @if (_continuation is not null)
        {
            <div class="d-flex justify-center mt-4">
                <SvButton Id="vault-load-more" Variant="SvButtonVariant.Secondary" Busy="IsLoadingMore" Disabled="IsCommandRunning" OnClick="@LoadMoreAsync">Load more</SvButton>
            </div>
        }
    </ChildContent>
</DataStateView>
