@inherits SharpVaultComponentBase
@inject SecretClipboard Clipboard
@inject VaultUiSettings Settings

<SvDialog IdPrefix="generator" Title="Generate a password" Open="@Open" OnCancel="@HandleCancel">
    <ChildContent>
        <SvStack Spacing="2">
            <SvStack Row="true" Spacing="2">
                <SvButton Id="generator-mode-password" Variant="@ModeVariant(GeneratorMode.Password)" OnClick="@(() => SelectMode(GeneratorMode.Password))">Password</SvButton>
                <SvButton Id="generator-mode-passphrase" Variant="@ModeVariant(GeneratorMode.Passphrase)" OnClick="@(() => SelectMode(GeneratorMode.Passphrase))">Passphrase</SvButton>
            </SvStack>
            @if (_mode == GeneratorMode.Password)
            {
                <PasswordOptionsPanel Options="@_password" OptionsChanged="@ChangePassword" />
            }
            else
            {
                <PassphraseOptionsPanel Options="@_passphrase" OptionsChanged="@ChangePassphrase" />
            }
            @if (_error is not null)
            {
                <SvAlert Id="generator-error" Kind="AlertKind.Danger">@_error</SvAlert>
            }
            else if (_generated is not null)
            {
                <code id="generator-output" class="sv-mono notranslate" translate="no" data-sv-sensitive="true">@_generated.Value</code>
                <SvText Id="generator-entropy" Kind="SvTextKind.Small">Entropy: @EntropyText bits</SvText>
                <SvText Id="generator-strength" Kind="SvTextKind.Small">Strength: @StrengthText</SvText>
            }
            <StatusBanner Id="generator-status" Message="@_status" ExpireAfter="@Settings.ClipboardClearDelay" />
        </SvStack>
    </ChildContent>
    <Footer>
        <SvButton Id="generator-cancel" Variant="SvButtonVariant.Secondary" OnClick="@HandleCancel">Cancel</SvButton>
        <SvButton Id="generator-regenerate" Variant="SvButtonVariant.Secondary" Icon="@SvIcons.Refresh" Disabled="@(_error is not null)" OnClick="@Regenerate">Regenerate</SvButton>
        <SvButton Id="generator-copy" Variant="SvButtonVariant.Secondary" Icon="@SvIcons.Copy" Disabled="@(_generated is null)" OnClick="@CopyAsync">Copy</SvButton>
        <SvButton Id="generator-use" Variant="SvButtonVariant.Primary" Disabled="@(_generated is null)" OnClick="@UseAsync">Use</SvButton>
    </Footer>
</SvDialog>
