@inherits SharpVaultComponentBase
@inject SecretClipboard Clipboard
@inject VaultUiSettings Settings

<SvPaper Id="secret-fields" Class="sv-plate-card">
    <dl class="sv-fields">
        <dt>Type</dt>
        <dd id="secret-type">@SecretTypeLabels.Label(Secret.Type)</dd>
        @if (ShowsUsername)
        {
            <dt>Username</dt>
            <dd>
                <span id="secret-username">@(Secret.Username ?? NoneText)</span>
                @if (!string.IsNullOrEmpty(Secret.Username))
                {
                    <SvIconButton Id="secret-username-copy" Icon="@SvIcons.Copy" Label="Copy username" OnClick="@CopyUsernameAsync" />
                }
            </dd>
        }
        @if (Secret.HasValue)
        {
            <dt>Value</dt>
            <dd>
                <RevealableField IdPrefix="secret-value" Label="Value" ShowLabel="false" Reveal="@RevealValue" OnFailure="@OnFailure" OnCopied="@ReportCopied" OnSucceeded="@OnSucceeded" />
            </dd>
        }
        @if (ShowsUrl)
        {
            <dt>URL</dt>
            <dd>
                @if (LinkTarget is { } target)
                {
                    <SvLink Id="secret-url" Href="@target" External="true">@Secret.Url</SvLink>
                }
                else
                {
                    <span id="secret-url">@(Secret.Url ?? NoneText)</span>
                }
            </dd>
        }
        @if (Secret.HasNotes)
        {
            <dt>Notes</dt>
            <dd>
                <RevealableField IdPrefix="secret-notes" Label="Notes" ShowLabel="false" Reveal="@RevealNotes" OnFailure="@OnFailure" OnCopied="@ReportCopied" OnSucceeded="@OnSucceeded" />
            </dd>
        }
        <dt>Tags</dt>
        <dd id="secret-tags">@(Secret.Tags.Count == 0 ? NoneText : SecretRequestMapper.JoinTags(Secret.Tags))</dd>
        @if (ShowFolder)
        {
            <dt>Folder</dt>
            <dd id="secret-folder">@(FolderName ?? RootFolderText)</dd>
        }
        <dt>Created</dt>
        <dd id="secret-created">@Stamp(Secret.CreatedAt)</dd>
        <dt>Modified</dt>
        <dd id="secret-modified">@Stamp(Secret.ModifiedAt)</dd>
    </dl>
</SvPaper>

@code {
    public const string NoneText = "None";
    public const string RootFolderText = "No folder";

    [Parameter, EditorRequired]
    public SecretDto Secret { get; set; } = default!;

    [Parameter]
    public string? FolderName { get; set; }

    [Parameter]
    public bool ShowFolder { get; set; } = true;

    [Parameter, EditorRequired]
    public Func<RevealFieldDto, RevealIntentDto, CancellationToken, Task<ApiResponse<RevealedValueDto>>> Reveal { get; set; } = default!;

    [Parameter]
    public EventCallback<ApiCallStatus> OnFailure { get; set; }

    [Parameter]
    public EventCallback<string> OnStatus { get; set; }

    [Parameter]
    public EventCallback OnSucceeded { get; set; }

    private bool ShowsUsername => VaultFieldRules.ShowsCredentialFields(Secret.Type) || !string.IsNullOrEmpty(Secret.Username);

    private bool ShowsUrl => VaultFieldRules.ShowsCredentialFields(Secret.Type) || !string.IsNullOrEmpty(Secret.Url);

    private string? LinkTarget =>
        Uri.TryCreate(Secret.Url, UriKind.Absolute, out var uri) && uri.Scheme is "http" or "https" ? uri.AbsoluteUri : null;

    protected override void OnParametersSet()
    {
        ArgumentNullException.ThrowIfNull(Secret);
        ArgumentNullException.ThrowIfNull(Reveal);
    }

    private Task<ApiResponse<RevealedValueDto>> RevealValue(RevealIntentDto intent, CancellationToken cancellationToken) =>
        Reveal(RevealFieldDto.Value, intent, cancellationToken);

    private Task<ApiResponse<RevealedValueDto>> RevealNotes(RevealIntentDto intent, CancellationToken cancellationToken) =>
        Reveal(RevealFieldDto.Notes, intent, cancellationToken);

    private Task ReportCopied() => OnStatus.InvokeAsync(SecretStatusText.Copied(Settings));

    private async Task CopyUsernameAsync()
    {
        if (Secret.Username is null)
        {
            return;
        }

        var copied = await Clipboard.CopyAsync(Secret.Username, Cts.Token);
        if (copied)
        {
            await ReportCopied();
            return;
        }

        await OnFailure.InvokeAsync(ApiCallStatus.Failed);
    }

    private static string Stamp(DateTimeOffset value) => StampText.For(value);
}
