@inherits LoadableComponentBase<SecretDto>

<DataStateView TValue="SecretDto" IdPrefix="secret-editor" State="State" Value="Value" ErrorText="@ErrorText" OnRetry="ReloadAsync">
    <ChildContent Context="secret">
        <SvPageTitle Id="secret-editor-heading">@(IsNew ? "New item" : "Edit item")</SvPageTitle>
        @if (secret.IsDamaged)
        {
            <SvAlert Id="secret-editor-damaged" Kind="AlertKind.Warning">@DamagedText</SvAlert>
            <SvButton Id="secret-cancel" Variant="SvButtonVariant.Secondary" Href="@CancelRoute">Back</SvButton>
        }
        else
        {
            @if (SecretId is { } editedId)
            {
                <OneTimeLinkEditWarning SecretId="@editedId" />
            }
            @if (_conflict)
            {
                <SvAlert Id="secret-conflict" Kind="AlertKind.Warning">
                    <p>@ConflictText</p>
                    <SvButton Id="secret-conflict-reload" Variant="SvButtonVariant.Secondary" Icon="@SvIcons.Refresh" OnClick="@ReloadAsync">Reload and discard my changes</SvButton>
                </SvAlert>
            }
            @if (_formError is not null)
            {
                <SvAlert Id="secret-form-error" Kind="AlertKind.Danger">@_formError</SvAlert>
            }
            <SecretForm Model="@_model"
                        IsNew="@IsNew"
                        Busy="@IsCommandRunning"
                        @bind-TagsText="_tagsText"
                        @bind-FolderId="_folderId"
                        Folders="@_folders"
                        FoldersUnavailable="@_foldersUnavailable"
                        OnReplaceNotesChanged="@ReplaceNotesChangedAsync"
                        OnValueGenerated="@ApplyGeneratedValue" />
            <SvStack Row="true" Spacing="2" Class="mt-4">
                <SvButton Id="secret-save" Variant="SvButtonVariant.Primary" Busy="@IsCommandRunning" OnClick="@SaveAsync">Save</SvButton>
                <SvButton Id="secret-cancel" Variant="SvButtonVariant.Secondary" Disabled="@IsCommandRunning" Href="@CancelRoute">Cancel</SvButton>
            </SvStack>
        }
    </ChildContent>
</DataStateView>
