<SvTable Id="bin-list" TItem="RecycleBinItemDto" Items="Items">
    <Columns>
        <SvColumn TItem="RecycleBinItemDto" Header="Name" Context="item">
            <span id="@RecycleBinItemText.IdFor("bin-name", item)">@RecycleBinItemText.DisplayName(item)</span>
            @if (item.IsDamaged)
            {
                <StatusChip Id="@RecycleBinItemText.IdFor("bin-damaged", item)" Status="SecurityStatus.Warning" Label="Damaged" />
            }
        </SvColumn>
        <SvColumn TItem="RecycleBinItemDto" Header="Type" Value="@RecycleBinItemText.KindLabel" />
        <SvColumn TItem="RecycleBinItemDto" Header="Expires" Context="item">
            <span id="@RecycleBinItemText.IdFor("bin-expires", item)">@RecycleBinItemText.ExpiresText(item)</span>
        </SvColumn>
        <SvColumn TItem="RecycleBinItemDto" Header="Actions" Context="item">
            <SvButton Id="@RecycleBinItemText.IdFor("bin-restore", item)" Variant="SvButtonVariant.Secondary" Icon="@SvIcons.Restore" Disabled="Disabled" OnClick="@(() => OnRestore.InvokeAsync(item))">Restore</SvButton>
            <SvButton Id="@RecycleBinItemText.IdFor("bin-purge", item)" Variant="SvButtonVariant.Danger" Icon="@SvIcons.Delete" Disabled="Disabled" OnClick="@(() => OnPurge.InvokeAsync(item))">Delete forever</SvButton>
        </SvColumn>
    </Columns>
</SvTable>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<RecycleBinItemDto> Items { get; set; } = [];

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public EventCallback<RecycleBinItemDto> OnRestore { get; set; }

    [Parameter]
    public EventCallback<RecycleBinItemDto> OnPurge { get; set; }
}
