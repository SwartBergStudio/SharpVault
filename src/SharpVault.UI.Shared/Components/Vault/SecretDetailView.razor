@inherits LoadableComponentBase<SecretDto>

<DataStateView TValue="SecretDto" IdPrefix="secret-detail" State="State" Value="Value" ErrorText="@ErrorText" OnRetry="ReloadAsync">
    <ChildContent Context="secret">
        <SvPageTitle Id="secret-heading">@SecretDisplayName.For(secret)</SvPageTitle>
        @if (secret.IsDamaged)
        {
            <SvAlert Id="secret-damaged" Kind="AlertKind.Warning">This item could not be read. You can still delete it.</SvAlert>
        }
        @if (_foldersUnavailable && !secret.IsDamaged)
        {
            <SvAlert Id="secret-folders-unavailable" Kind="AlertKind.Info">Folders could not be loaded, so this item cannot be moved right now. Reload the page to try again.</SvAlert>
        }
        <StatusBanner Id="secret-status" Message="@_status" ExpireAfter="@Settings.ClipboardClearDelay" />
        @if (!secret.IsDamaged)
        {
            <SecretDetailFields Secret="@secret" FolderName="@FolderNameOf(secret)" Reveal="@RevealFieldAsync" OnFailure="@ReportFailure" OnStatus="@ReportInfo" OnSucceeded="@ClearFailure" />
        }
        @if (CurrentUser is { } user)
        {
            <OneTimeLinkButton OwnerId="@user.UserId" SecretId="@secret.Id" />
            <SharePanel @key="secret.Id" OwnerId="@user.UserId" Kind="SharedItemKindDto.Secret" ItemId="@secret.Id" />
        }
        <SvStack Row="true" Spacing="2" Class="mt-4">
            @if (!secret.IsDamaged)
            {
                <SvButton Id="secret-edit" Variant="SvButtonVariant.Primary" Icon="@SvIcons.Edit" Href="@VaultRoutes.EditSecret(secret.Id)">Edit</SvButton>
                <SvButton Id="secret-move" Variant="SvButtonVariant.Secondary" Icon="@SvIcons.Move" Disabled="@_foldersUnavailable" OnClick="@OpenMove">Move</SvButton>
            }
            <SvButton Id="secret-history-link" Variant="SvButtonVariant.Secondary" Icon="@SvIcons.History" Href="@VaultRoutes.History(secret.Id)">History</SvButton>
            <SvButton Id="secret-delete" Variant="SvButtonVariant.Danger" Icon="@SvIcons.Delete" OnClick="@OpenDelete">Delete</SvButton>
        </SvStack>
        <ConfirmDialog IdPrefix="secret-delete-prompt" Title="Delete this item?" Open="@_deleteOpen" Danger="true" ConfirmText="Delete" Busy="@IsCommandRunning" OnConfirm="@DeleteAsync" OnCancel="@CloseDelete">
            <p>The item moves to the recycle bin. @SharedItemStatusText.SharingNoticeOnDelete</p>
        </ConfirmDialog>
        <MoveSecretDialog Open="@_moveOpen" CurrentFolderId="@secret.FolderId" Folders="@_folders" Busy="@IsCommandRunning" ErrorText="@_moveError" OnConfirm="@MoveAsync" OnCancel="@CloseMove" />
    </ChildContent>
</DataStateView>
