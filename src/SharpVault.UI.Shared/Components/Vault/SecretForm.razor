<SvStack Spacing="3">
    <SvTextField Id="secret-name-input" Label="Name" Required="true" MaxLength="@VaultFieldRules.NameMaxLength" Disabled="@Busy" @bind-Value="Model.Name" />
    <SvSelect Id="secret-type-select" Label="Type" Options="@SecretTypeLabels.Options" Value="@Model.Type.ToString()" ValueChanged="@HandleTypeChanged" Disabled="@Busy" />
    @if (VaultFieldRules.ShowsCredentialFields(Model.Type))
    {
        <SvTextField Id="secret-username-input" Label="Username" MaxLength="@VaultFieldRules.UsernameMaxLength" Disabled="@Busy" @bind-Value="Model.Username" />
        @if (!IsNew)
        {
            <SvCheckbox Id="secret-change-value" Label="Change the value (leave it empty to clear it)" Value="@Model.ReplaceValue" ValueChanged="@HandleReplaceValueChanged" Disabled="@Busy" />
        }
        <SvStack Row="true" Spacing="2" Center="true">
            <SvTextField Id="secret-value-input" Label="Value" Secret="true" Revealed="@_valueShown" MaxLength="@VaultFieldRules.ValueMaxLength" Disabled="@(Busy || ValueLocked)" @bind-Value="Model.Value" />
            <SvIconButton Id="secret-value-toggle" Icon="@(_valueShown ? SvIcons.Hide : SvIcons.Show)" Label="@(_valueShown ? "Hide the value" : "Show the value")" OnClick="@ToggleValueShown" />
            <SvButton Id="secret-generate" Variant="SvButtonVariant.Secondary" Icon="@SvIcons.Generate" Disabled="@Busy" OnClick="@OpenGenerator">Generate</SvButton>
        </SvStack>
        <SvTextField Id="secret-url-input" Label="URL" MaxLength="@VaultFieldRules.UrlMaxLength" Disabled="@Busy" @bind-Value="Model.Url" />
    }
    @if (!IsNew)
    {
        <SvCheckbox Id="secret-change-notes" Label="@NotesCheckboxLabel" Value="@Model.ReplaceNotes" ValueChanged="@OnReplaceNotesChanged" Disabled="@Busy" />
    }
    <SvTextField Id="secret-notes-input" Label="Notes" Secret="true" Revealed="true" Lines="5" MaxLength="@VaultFieldRules.NotesMaxLength" Disabled="@(Busy || NotesLocked)" @bind-Value="Model.Notes" />
    <SvTextField Id="secret-tags-input" Label="Tags (comma separated)" Disabled="@Busy" Value="@TagsText" ValueChanged="@TagsTextChanged" />
    @if (IsNew)
    {
        <FolderPicker Id="secret-folder-select" Label="Folder" Folders="@Folders" Value="@FolderId" ValueChanged="@FolderIdChanged" />
        @if (FoldersUnavailable)
        {
            <SvAlert Id="secret-folders-unavailable" Kind="AlertKind.Info">Folders could not be loaded, so this item will be saved without a folder. You can move it later.</SvAlert>
        }
    }
</SvStack>
<PasswordGeneratorDialog Open="@_generatorOpen" OnUse="@UseGeneratedAsync" OnCancel="@CloseGenerator" />

@code {
    public const string NotesCheckboxLabel = "Change the notes";

    private bool _valueShown;
    private bool _generatorOpen;

    [Parameter, EditorRequired]
    public UpdateSecretRequestDto Model { get; set; } = default!;

    [Parameter]
    public bool IsNew { get; set; }

    [Parameter]
    public bool Busy { get; set; }

    [Parameter]
    public string? TagsText { get; set; }

    [Parameter]
    public EventCallback<string> TagsTextChanged { get; set; }

    [Parameter]
    public Guid? FolderId { get; set; }

    [Parameter]
    public EventCallback<Guid?> FolderIdChanged { get; set; }

    [Parameter]
    public bool FoldersUnavailable { get; set; }

    [Parameter]
    public IReadOnlyList<FolderDto> Folders { get; set; } = [];

    [Parameter]
    public EventCallback<bool> OnReplaceNotesChanged { get; set; }

    [Parameter]
    public EventCallback<string> OnValueGenerated { get; set; }

    private bool ValueLocked => !IsNew && !Model.ReplaceValue;

    private bool NotesLocked => !IsNew && !Model.ReplaceNotes;

    protected override void OnParametersSet() => ArgumentNullException.ThrowIfNull(Model);

    private void HandleTypeChanged(string value) => Model.Type = SecretTypeLabels.Parse(value, Model.Type);

    private void HandleReplaceValueChanged(bool replace)
    {
        Model.ReplaceValue = replace;
        Model.Value = null;
    }

    private void ToggleValueShown() => _valueShown = !_valueShown;

    private void OpenGenerator() => _generatorOpen = true;

    private void CloseGenerator() => _generatorOpen = false;

    private async Task UseGeneratedAsync(string value)
    {
        _generatorOpen = false;
        await OnValueGenerated.InvokeAsync(value);
    }
}
