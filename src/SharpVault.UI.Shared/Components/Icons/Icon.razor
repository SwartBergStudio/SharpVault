@code {
    [Parameter]
    public IconName Name { get; set; }

    [Parameter]
    public string? Label { get; set; }

    [Parameter]
    public string? CssClass { get; set; }

    private bool HasLabel => !string.IsNullOrWhiteSpace(Label);

    private string ClassNames => string.IsNullOrWhiteSpace(CssClass) ? "sv-icon" : $"sv-icon {CssClass}";
}
