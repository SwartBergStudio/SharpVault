@inherits LoadableComponentBase<SharedSecretDto>

<DataStateView TValue="SharedSecretDto" IdPrefix="shared-secret-detail" State="State" Value="Value" ErrorText="@SharedLoadErrors.ForLoad(ErrorText)" OnRetry="ReloadAsync">
    <ChildContent Context="shared">
        <SvPageTitle Id="shared-secret-heading">@SecretDisplayName.For(shared.Item)</SvPageTitle>
        <SvStack Row="true" Spacing="2" Class="mb-2">
            <SvText Id="shared-secret-owner" Secondary="true">Shared by @shared.OwnerDisplayName</SvText>
            <SvText Id="shared-secret-permission" Secondary="true">@PermissionLabels.Label(shared.Permission)</SvText>
        </SvStack>
        @if (shared.Item.IsDamaged)
        {
            <SvAlert Id="shared-secret-damaged" Kind="AlertKind.Warning">@SharedItemStatusText.DamagedItem</SvAlert>
        }
        <StatusBanner Id="shared-secret-status" Message="@_status" ExpireAfter="@Settings.ClipboardClearDelay" />
        @if (!shared.Item.IsDamaged)
        {
            <SecretDetailFields Secret="@shared.Item" ShowFolder="false" Reveal="@RevealFieldAsync" OnFailure="@ReportFailure" OnStatus="@ReportInfo" OnSucceeded="@ClearFailure" />
        }
        @if (shared.Permission == SharePermissionDto.Manage)
        {
            <SharePanel @key="shared.Item.Id" OwnerId="@shared.OwnerId" Kind="SharedItemKindDto.Secret" ItemId="@shared.Item.Id" />
        }
        @if (CanEdit(shared))
        {
            <SvStack Row="true" Spacing="2" Class="mt-4">
                <SvButton Id="shared-secret-edit" Variant="SvButtonVariant.Primary" Icon="@SvIcons.Edit" Href="@SharingRoutes.EditSecret(OwnerId, SecretId)">Edit</SvButton>
            </SvStack>
        }
    </ChildContent>
</DataStateView>
