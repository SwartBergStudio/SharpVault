@inherits LoadableComponentBase<SharedSecretDto>

<DataStateView TValue="SharedSecretDto" IdPrefix="shared-secret-editor" State="State" Value="Value" ErrorText="@SharedLoadErrors.ForLoad(ErrorText)" OnRetry="ReloadAsync">
    <ChildContent Context="shared">
        <SvPageTitle Id="shared-secret-editor-heading">Edit shared item</SvPageTitle>
        @if (_accessEnded)
        {
            <SvAlert Id="shared-secret-access-ended" Kind="AlertKind.Warning">@SharedItemStatusText.AccessEnded</SvAlert>
            <SvButton Id="shared-secret-cancel" Variant="SvButtonVariant.Secondary" Href="@SharingRoutes.Shared">Back</SvButton>
        }
        else if (shared.Item.IsDamaged || !CanEdit(shared))
        {
            <SvAlert Id="shared-secret-editor-blocked" Kind="AlertKind.Warning">@BlockedText(shared)</SvAlert>
            <SvButton Id="shared-secret-cancel" Variant="SvButtonVariant.Secondary" Href="@CancelRoute">Back</SvButton>
        }
        else
        {
            @if (_conflict)
            {
                <SvAlert Id="shared-secret-conflict" Kind="AlertKind.Warning">
                    <p>@SecretEditor.ConflictText</p>
                    <SvButton Id="shared-secret-conflict-reload" Variant="SvButtonVariant.Secondary" Icon="@SvIcons.Refresh" OnClick="@ReloadAsync">Reload and discard my changes</SvButton>
                </SvAlert>
            }
            @if (_formError is not null)
            {
                <SvAlert Id="shared-secret-form-error" Kind="AlertKind.Danger">@_formError</SvAlert>
            }
            <SecretForm Model="@_model"
                        IsNew="false"
                        Busy="@IsCommandRunning"
                        @bind-TagsText="_tagsText"
                        OnReplaceNotesChanged="@ReplaceNotesChangedAsync"
                        OnValueGenerated="@ApplyGeneratedValue" />
            <SvStack Row="true" Spacing="2" Class="mt-4">
                <SvButton Id="shared-secret-save" Variant="SvButtonVariant.Primary" Busy="@IsCommandRunning" OnClick="@SaveAsync">Save</SvButton>
                <SvButton Id="shared-secret-cancel" Variant="SvButtonVariant.Secondary" Disabled="@IsCommandRunning" Href="@CancelRoute">Cancel</SvButton>
            </SvStack>
        }
    </ChildContent>
</DataStateView>
