@inherits LoadableComponentBase<CurrentUserDto>
@inject ICurrentUserAccessor CurrentUserAccessor

<DataStateView TValue="CurrentUserDto" IdPrefix="account" State="State" Value="Value" ErrorText="@ErrorText" OnRetry="ReloadAsync">
    <ChildContent Context="profile">
        <SvPaper Id="account-section" Class="sv-plate-card">
            <p class="sv-plate">Identity plate</p>
            <dl class="sv-fields">
                <dt>Name</dt>
                <dd id="account-display-name">@(string.IsNullOrWhiteSpace(profile.DisplayName) ? NoNameText : profile.DisplayName)</dd>
                <dt>User id</dt>
                <dd id="account-user-id" class="sv-mono">@profile.UserId</dd>
            </dl>
            @if (profile.IsAdmin)
            {
                <StatusChip Id="account-admin-badge" Status="SecurityStatus.Active" Icon="@SvIcons.Admin" Label="Administrator" />
            }
        </SvPaper>
    </ChildContent>
</DataStateView>

@code {
    private const string NoNameText = "No name on file";

    protected override Task<ApiResponse<CurrentUserDto>> LoadAsync(CancellationToken cancellationToken) =>
        CurrentUserAccessor.GetAsync(cancellationToken);
}
