@inject ISessionActions SessionActions
@inject NavigationManager Navigation

<nav id="account-menu" class="sv-account" aria-label="Account">
    <AuthorizeView>
        <Authorized>
            <span class="sv-account__who d-none d-md-inline-flex">
                <SvIcon Icon="@SvIcons.User" Small="true" />
                <span id="account-name">@context.User.Identity?.Name</span>
            </span>
            <span class="d-none d-sm-inline-flex">
                <SvButton Id="account-link" Variant="SvButtonVariant.Ghost" Href="@AccountRoutes.Account">Account</SvButton>
            </span>
            <form id="@SessionActions.SignOutFormId" method="post" action="@SessionActions.SignOutAction">
                <AntiforgeryToken />
                <SvButton Id="sign-out-button" Variant="SvButtonVariant.Secondary" Icon="@SvIcons.SignOut" ButtonType="ButtonType.Submit">Sign out</SvButton>
            </form>
        </Authorized>
        <NotAuthorized>
            @if (!SessionActions.IsSignInPage(Navigation.ToBaseRelativePath(Navigation.Uri)))
            {
                <SignInLink Id="sign-in-link" Text="Sign in" />
            }
        </NotAuthorized>
    </AuthorizeView>
</nav>

