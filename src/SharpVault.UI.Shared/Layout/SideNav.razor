<AuthorizeView>
    <Authorized>
        <SvDrawer Open="@Open" OpenChanged="@OpenChanged">
            <SvNavMenu Id="side-nav" Label="Main">
                <SvNavLink Id="nav-vault" Href="@VaultRoutes.Vault" ExactMatch="true" Icon="@SvIcons.Vault">Vault</SvNavLink>
                <SvNavLink Id="nav-shared" Href="@SharingRoutes.Shared" Icon="@SvIcons.People">Shared with me</SvNavLink>
                <SvNavLink Id="nav-recycle-bin" Href="@VaultRoutes.RecycleBin" Icon="@SvIcons.Delete">Recycle bin</SvNavLink>
                <SvNavLink Id="nav-one-time-links" Href="@OneTimeLinkRoutes.Links" Icon="@SvIcons.Link">One-time links</SvNavLink>
                <SvNavLink Id="nav-account" Href="@AccountRoutes.Account" Icon="@SvIcons.User">Account</SvNavLink>
                @if (CurrentUser is { IsAdmin: true })
                {
                    <SvText Id="nav-admin-heading" Kind="SvTextKind.Overline" Class="sv-sidenav__group">Administration</SvText>
                    <SvNavLink Id="nav-admin-users" Href="@AccountRoutes.AdminUsers" Icon="@SvIcons.Admin">Users</SvNavLink>
                    <SvNavLink Id="nav-admin-transfers" Href="@TransferRoutes.Transfers" Icon="@SvIcons.Transfer">Transfers</SvNavLink>
                }
            </SvNavMenu>
        </SvDrawer>
    </Authorized>
</AuthorizeView>

@code {
    [Parameter]
    public bool Open { get; set; }

    [Parameter]
    public EventCallback<bool> OpenChanged { get; set; }

    [CascadingParameter(Name = LayoutCascades.CurrentUser)]
    private CurrentUserDto? CurrentUser { get; set; }
}
